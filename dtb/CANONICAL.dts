/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Lenovo Tab M10 Plus 3rd gen";
	compatible = "lenovo,tb128\0qcom,sm6225\0qcom,sm6115";
	chassis-type = "tablet";
	qcom,msm-id = <0x206 0x10000>;
	qcom,board-id = <0x10022 0x00>;
	qcom,pmic-id = <0x2d 0x00 0x00 0x00>;

	chosen {
		linux,initrd-start = <0x00 0x44986000>;
		linux,initrd-end = <0x00 0x456fe3fc>;
		kaslr-seed = <0x00 0x00>;
		bootargs = "root=/dev/sda18 rw rootwait noinitrd init=/sbin/init console=tty0 PMOS_NOSPLASH";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0:115200n8";

		framebuffer@5c000000 {
			compatible = "simple-framebuffer";
			reg = <0x00 0x5c000000 0x00 0x927c00>;
			width = <0x4b0>;
			height = <0x7d0>;
			stride = <0x12c0>;
			format = "a8r8g8b8";
			clocks = <0x02 0x4c>;
		};
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x124f800>;
			phandle = <0x25>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			phandle = <0x2c>;
		};

		usb3_phy_wrapper_gcc_usb30_pipe_clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x3e8>;
			clock-output-names = "usb3_phy_wrapper_gcc_usb30_pipe_clk";
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x00>;
			clocks = <0x03 0x00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x03 0x00>;
			power-domains = <0x05>;
			power-domain-names = "psci";
			phandle = <0x0e>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x04>;
			};
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x01>;
			clocks = <0x03 0x00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x03 0x00>;
			power-domains = <0x06>;
			power-domain-names = "psci";
			phandle = <0x0f>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x02>;
			clocks = <0x03 0x00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x03 0x00>;
			power-domains = <0x07>;
			power-domain-names = "psci";
			phandle = <0x10>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x03>;
			clocks = <0x03 0x00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x03 0x00>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			phandle = <0x11>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x100>;
			clocks = <0x03 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x666>;
			dynamic-power-coefficient = <0x11a>;
			next-level-cache = <0x09>;
			qcom,freq-domain = <0x03 0x01>;
			power-domains = <0x0a>;
			power-domain-names = "psci";
			phandle = <0x12>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x09>;
			};
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x101>;
			clocks = <0x03 0x01>;
			capacity-dmips-mhz = <0x666>;
			dynamic-power-coefficient = <0x11a>;
			enable-method = "psci";
			next-level-cache = <0x09>;
			qcom,freq-domain = <0x03 0x01>;
			power-domains = <0x0b>;
			power-domain-names = "psci";
			phandle = <0x13>;
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x102>;
			clocks = <0x03 0x01>;
			capacity-dmips-mhz = <0x666>;
			dynamic-power-coefficient = <0x11a>;
			enable-method = "psci";
			next-level-cache = <0x09>;
			qcom,freq-domain = <0x03 0x01>;
			power-domains = <0x0c>;
			power-domain-names = "psci";
			phandle = <0x14>;
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x103>;
			clocks = <0x03 0x01>;
			capacity-dmips-mhz = <0x666>;
			dynamic-power-coefficient = <0x11a>;
			enable-method = "psci";
			next-level-cache = <0x09>;
			qcom,freq-domain = <0x03 0x01>;
			power-domains = <0x0d>;
			power-domain-names = "psci";
			phandle = <0x15>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0e>;
				};

				core1 {
					cpu = <0x0f>;
				};

				core2 {
					cpu = <0x10>;
				};

				core3 {
					cpu = <0x11>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x12>;
				};

				core1 {
					cpu = <0x13>;
				};

				core2 {
					cpu = <0x14>;
				};

				core3 {
					cpu = <0x15>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "silver-rail-power-collapse";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <0x122>;
				exit-latency-us = <0x178>;
				min-residency-us = <0x49e>;
				local-timer-stop;
				phandle = <0x1c>;
			};

			cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "gold-rail-power-collapse";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <0x129>;
				exit-latency-us = <0x144>;
				min-residency-us = <0x456>;
				local-timer-stop;
				phandle = <0x1e>;
			};
		};

		domain-idle-states {

			cluster-sleep-0-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x40000022>;
				entry-latency-us = <0x168>;
				exit-latency-us = <0x1a5>;
				min-residency-us = <0x30e>;
				phandle = <0x1f>;
			};

			cluster-sleep-0-1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x41000044>;
				entry-latency-us = <0x320>;
				exit-latency-us = <0x846>;
				min-residency-us = <0x1cd0>;
				phandle = <0x20>;
			};

			cluster-sleep-1-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x40000042>;
				entry-latency-us = <0x13a>;
				exit-latency-us = <0x159>;
				min-residency-us = <0x294>;
				phandle = <0x21>;
			};

			cluster-sleep-1-1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x41000044>;
				entry-latency-us = <0x280>;
				exit-latency-us = <0x676>;
				min-residency-us = <0x1f9e>;
				phandle = <0x22>;
			};
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-sm6115\0qcom,scm";
			#reset-cells = <0x01>;
			interconnects = <0x16 0x00 0x03 0x17 0x06 0x03>;
		};
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x00>;
	};

	opp-table-qup {
		compatible = "operating-points-v2";
		phandle = <0x58>;

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x18>;
		};

		opp-100000000 {
			opp-hz = <0x00 0x5f5e100>;
			required-opps = <0x19>;
		};

		opp-128000000 {
			opp-hz = <0x00 0x7a12000>;
			required-opps = <0x1a>;
		};
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x06 0x04>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x05>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x06>;
		};

		power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x07>;
		};

		power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x08>;
		};

		power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1d>;
			domain-idle-states = <0x1e>;
			phandle = <0x0a>;
		};

		power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1d>;
			domain-idle-states = <0x1e>;
			phandle = <0x0b>;
		};

		power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1d>;
			domain-idle-states = <0x1e>;
			phandle = <0x0c>;
		};

		power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1d>;
			domain-idle-states = <0x1e>;
			phandle = <0x0d>;
		};

		power-domain-cpu-cluster0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x1f 0x20>;
			phandle = <0x1b>;
		};

		power-domain-cpu-cluster1 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x21 0x22>;
			phandle = <0x1d>;
		};
	};

	remoteproc {
		compatible = "qcom,sm6115-rpm-proc\0qcom,rpm-proc";

		glink-edge {
			compatible = "qcom,glink-rpm";
			interrupts = <0x00 0xc2 0x01>;
			qcom,rpm-msg-ram = <0x23>;
			mboxes = <0x24 0x00>;

			rpm-requests {
				compatible = "qcom,rpm-sm6115\0qcom,glink-smd-rpm";
				qcom,glink-channels = "rpm_requests";

				clock-controller {
					compatible = "qcom,rpmcc-sm6115\0qcom,rpmcc";
					clocks = <0x25>;
					clock-names = "xo";
					#clock-cells = <0x01>;
					phandle = <0x2b>;
				};

				power-controller {
					compatible = "qcom,sm6115-rpmpd";
					#power-domain-cells = <0x01>;
					operating-points-v2 = <0x26>;
					phandle = <0x37>;

					opp-table {
						compatible = "operating-points-v2";
						phandle = <0x26>;

						opp1 {
							opp-level = <0x30>;
							phandle = <0x75>;
						};

						opp2 {
							opp-level = <0x40>;
							phandle = <0x18>;
						};

						opp3 {
							opp-level = <0x80>;
							phandle = <0x19>;
						};

						opp4 {
							opp-level = <0xc0>;
							phandle = <0x3a>;
						};

						opp5 {
							opp-level = <0x100>;
							phandle = <0x1a>;
						};

						opp6 {
							opp-level = <0x140>;
							phandle = <0x6d>;
						};

						opp7 {
							opp-level = <0x180>;
							phandle = <0x6e>;
						};

						opp8 {
							opp-level = <0x1a0>;
							phandle = <0x6f>;
						};
					};
				};

				regulators-0 {
					compatible = "qcom,rpm-pm6125-regulators";

					s6 {
						regulator-min-microvolt = <0x61a80>;
						regulator-max-microvolt = <0x15a6f8>;
					};

					s7 {
						regulator-min-microvolt = <0x17f0e8>;
						regulator-max-microvolt = <0x1f20c0>;
					};

					s8 {
						regulator-min-microvolt = <0x102ca0>;
						regulator-max-microvolt = <0x11da50>;
					};

					l1 {
						regulator-min-microvolt = <0xe7ef0>;
						regulator-max-microvolt = <0x118c30>;
					};

					l4 {
						regulator-min-microvolt = <0xafc80>;
						regulator-max-microvolt = <0x100590>;
						phandle = <0x2d>;
					};

					l5 {
						regulator-min-microvolt = <0x192580>;
						regulator-max-microvolt = <0x30d400>;
						regulator-allow-set-load;
						regulator-always-on;
						phandle = <0x3f>;
					};

					l6 {
						regulator-min-microvolt = <0x8b290>;
						regulator-max-microvolt = <0x9eb10>;
					};

					l7 {
						regulator-min-microvolt = <0x132a40>;
						regulator-max-microvolt = <0x132a40>;
						regulator-always-on;
					};

					l8 {
						regulator-min-microvolt = <0x61a80>;
						regulator-max-microvolt = <0xb1bc0>;
						phandle = <0xa7>;
					};

					l9 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x4c>;
					};

					l10 {
						regulator-min-microvolt = <0x19f0a0>;
						regulator-max-microvolt = <0x1cfde0>;
					};

					l11 {
						regulator-min-microvolt = <0x19f0a0>;
						regulator-max-microvolt = <0x1dc130>;
						phandle = <0x42>;
					};

					l12 {
						regulator-min-microvolt = <0x18b820>;
						regulator-max-microvolt = <0x1e3660>;
						phandle = <0x2e>;
					};

					l13 {
						regulator-min-microvolt = <0x16f300>;
						regulator-max-microvolt = <0x1e8480>;
					};

					l14 {
						regulator-min-microvolt = <0x19f0a0>;
						regulator-max-microvolt = <0x1cfde0>;
					};

					l15 {
						regulator-min-microvolt = <0x2932e0>;
						regulator-max-microvolt = <0x3613c0>;
						phandle = <0x2f>;
					};

					l16 {
						regulator-min-microvolt = <0x19f0a0>;
						regulator-max-microvolt = <0x1cfde0>;
						phandle = <0x59>;
					};

					l17 {
						regulator-min-microvolt = <0x13e5c0>;
						regulator-max-microvolt = <0x13e5c0>;
						phandle = <0xa8>;
					};

					l18 {
						regulator-min-microvolt = <0x10c8e0>;
						regulator-max-microvolt = <0x13d620>;
						phandle = <0x43>;
					};

					l19 {
						regulator-min-microvolt = <0x18b820>;
						regulator-max-microvolt = <0x325aa0>;
					};

					l20 {
						regulator-min-microvolt = <0x18b820>;
						regulator-max-microvolt = <0x325aa0>;
					};

					l21 {
						regulator-min-microvolt = <0x186a00>;
						regulator-max-microvolt = <0x3613c0>;
					};

					l22 {
						regulator-min-microvolt = <0x2d0370>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-allow-set-load;
						regulator-always-on;
						phandle = <0x3e>;
					};

					l23 {
						regulator-min-microvolt = <0x30d400>;
						regulator-max-microvolt = <0x33e140>;
						phandle = <0xa9>;
					};

					l24 {
						regulator-min-microvolt = <0x2932e0>;
						regulator-max-microvolt = <0x3613c0>;
						phandle = <0x41>;
					};
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		memory@45700000 {
			reg = <0x00 0x45700000 0x00 0x600000>;
			no-map;
		};

		memory@45e00000 {
			reg = <0x00 0x45e00000 0x00 0x140000>;
			no-map;
		};

		memory@45fff000 {
			reg = <0x00 0x45fff000 0x00 0x1000>;
			no-map;
		};

		memory@46000000 {
			compatible = "qcom,smem";
			reg = <0x00 0x46000000 0x00 0x200000>;
			no-map;
			hwlocks = <0x27 0x03>;
			qcom,rpm-msg-ram = <0x23>;
		};

		memory@46200000 {
			reg = <0x00 0x46200000 0x00 0x1e00000>;
			no-map;
		};

		memory@4ab00000 {
			reg = <0x00 0x4ab00000 0x00 0x6900000>;
			no-map;
			phandle = <0x7e>;
		};

		memory@51400000 {
			reg = <0x00 0x51400000 0x00 0x500000>;
			no-map;
		};

		memory@51900000 {
			reg = <0x00 0x51900000 0x00 0x100000>;
			no-map;
			phandle = <0xa6>;
		};

		memory@51a00000 {
			reg = <0x00 0x51a00000 0x00 0x1e00000>;
			no-map;
			phandle = <0xa4>;
		};

		memory@53800000 {
			reg = <0x00 0x53800000 0x00 0x1e00000>;
			no-map;
			phandle = <0xa1>;
		};

		memory@55600000 {
			reg = <0x00 0x55600000 0x00 0x10000>;
			no-map;
		};

		memory@55610000 {
			reg = <0x00 0x55610000 0x00 0x5000>;
			no-map;
		};

		memory@55615000 {
			reg = <0x00 0x55615000 0x00 0x2000>;
			no-map;
			phandle = <0x6c>;
		};

		splash_region@5c000000 {
			label = "cont_splash_region";
			reg = <0x00 0x5c000000 0x00 0xf00000>;
			no-map;
		};

		memory@5cf00000 {
			reg = <0x00 0x5cf00000 0x00 0x100000>;
			no-map;
		};

		memory@60000000 {
			reg = <0x00 0x60000000 0x00 0x3900000>;
			no-map;
		};

		memory@89b01000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x00 0x89b01000 0x00 0x300000>;
			no-map;
			qcom,client-id = <0x01>;
			qcom,vmid = <0x0f 0x2b>;
		};
	};

	smp2p-adsp {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1bb 0x1ad>;
		interrupts = <0x00 0x117 0x01>;
		mboxes = <0x24 0x0a>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x02>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0xa2>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0xa0>;
		};
	};

	smp2p-cdsp {
		compatible = "qcom,smp2p";
		qcom,smem = <0x5e 0x1b0>;
		interrupts = <0x00 0x107 0x01>;
		mboxes = <0x24 0x1e>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x05>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0xa5>;
