		display-thermal {
			thermal-sensors = <0xaa 0x0e>;

			trips {

				trip-point0 {
					temperature = <0x1c138>;
					hysteresis = <0x1388>;
					type = "passive";
				};

				trip-point1 {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "passive";
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xaa 0x0f>;

			cooling-maps {

				map0 {
					trip = <0xab>;
					cooling-device = <0xac 0xffffffff 0xffffffff>;
				};
			};

			trips {

				trip-point0 {
					temperature = <0x14c08>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0xab>;
				};

				trip-point1 {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		pm6125-thermal {
			polling-delay-passive = <0x64>;
			thermal-sensors = <0xad>;

			trips {

				trip0 {
					temperature = <0x17318>;
					hysteresis = <0x00>;
					type = "passive";
				};

				trip1 {
					temperature = <0x1c138>;
					hysteresis = <0x00>;
					type = "hot";
				};

				trip2 {
					temperature = <0x23668>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x01 0xf08 0x01 0x02 0xf08 0x01 0x03 0xf08 0x01 0x00 0xf08>;
	};

	mem-offline {
		compatible = "qcom,mem-offline";
		offline-sizes = <0x01 0x40000000 0x00 0x40000000 0x01 0xc0000000 0x00 0x80000000 0x02 0xc0000000 0x01 0x40000000>;
		granule = <0x200>;
	};

	ddr-regions {
	};

	aliases {
		mmc0 = "/soc/mmc@4784000";
		serial0 = "/soc/geniqup@4ac0000/serial@4a90000";
		serial1 = "/soc/geniqup@4ac0000/serial@4a8c000";
	};

	battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <0x15d1f0>;
		energy-full-design-microwatt-hours = <0x50b810>;
		voltage-min-design-microvolt = <0x30d400>;
		phandle = <0x4f>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <0xae>;

		key-volume-up {
			label = "Volume Up";
			linux,code = <0x73>;
			gpios = <0x36 0x05 0x01>;
			debounce-interval = <0x0f>;
			linux,can-disable;
			wakeup-source;
		};
	};

	regulator-0 {
		regulator-always-on;
		regulator-boot-on;
		compatible = "regulator-fixed";
		regulator-name = "vbus_p1";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x28 0x48 0x00>;
		enable-active-high;
		status = "okay";
	};
